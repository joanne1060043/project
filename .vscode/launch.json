{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Workspace (external)",
      "type": "debugpy",
      "request": "launch",

      "cwd": "${workspaceFolder}",

      "program": "${file}",

      "console": "externalTerminal",

      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },

    {
      "name": "Python: Workspace (internal)",
      "type": "debugpy",
      "request": "launch",

      "cwd": "${workspaceFolder}",

      "program": "${file}",

      "console": "integratedTerminal",

      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },

    {
      "name": "Python: Current File (workspace)",
      "type": "debugpy",
      "request": "launch",

      "cwd": "${workspaceFolder}",

      "program": "${file}",

      "console": "integratedTerminal",

      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
